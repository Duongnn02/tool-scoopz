{
  "manifest_version": 3,
  "name": "GPM Clipboard",
  "version": "1.0.0",
  "description": "Auto-repaired placeholder extension.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentscript.js"
      ],
      "run_at": "document_start"
    }
  ]
}